REPO_DIR="/path/to/CoolifyBR"

BACKUP_JOB_NAME="remote-coolify"
REMOTE_ALIAS="coolify-source"
REMOTE_HOST="203.0.113.10"
REMOTE_USER="root"
REMOTE_PORT="22"
REMOTE_PASSWORD=""
REMOTE_KEY_PATH="/root/.ssh/id_ed25519_remote_coolify"
REMOTE_HOST_FINGERPRINT=""

REMOTE_REPO_DIR="/root/CoolifyBR"
REMOTE_OUTPUT_DIR="/root/CoolifyBR/backups"

LOCAL_BACKUP_ROOT="/srv/backups/remote-coolify"

BACKUP_MODE="full"
# Extra flags passed straight to the remote coolify-backup.sh. Typical use is
# leaving out volumes that are either backed up another way or simply too big:
#   REMOTE_BACKUP_EXTRA_ARGS="--exclude-volume '*postgres-data*' --exclude-volume '*_logs'"
REMOTE_BACKUP_EXTRA_ARGS=""
VERIFY_AFTER_PULL="true"
VERIFY_VOLUME_ARCHIVES="true"
DELETE_REMOTE_ARCHIVE_AFTER_PULL="false"
DELETE_LOCAL_ARCHIVE_AFTER_EXTRACT="false"
RETENTION_DAILY="7"
RETENTION_WEEKLY="4"
RETENTION_MONTHLY="6"

# Remote globs whose NEWEST match is pulled into the snapshot, one per line.
# For data that is deliberately not in the Coolify archive — typically an
# application database, since tarring a live Postgres data directory does not
# produce a consistent backup, so it is excluded here and dumped separately on
# the source host. Leaving that dump on the host it protects is not a backup.
# With EXTRA_PULL_REQUIRED=true a pattern that matches nothing, or whose newest
# match is older than EXTRA_PULL_MAX_AGE_HOURS, fails the run — a dump cron that
# quietly stopped otherwise looks identical to one that is working.
EXTRA_PULL_NEWEST=""
EXTRA_PULL_REQUIRED="true"
EXTRA_PULL_MAX_AGE_HOURS="48"
